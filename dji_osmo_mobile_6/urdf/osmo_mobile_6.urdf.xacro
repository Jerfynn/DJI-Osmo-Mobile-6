<?xml version="1.0" encoding="utf-8"?>
<robot name="dji_osmo_mobile_6" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Arguments -->
  <xacro:arg name="use_collada" default="false"/>
  <xacro:arg name="fix_base" default="true"/>
  <xacro:arg name="phone_mass" default="0.180"/>

  <!-- Choose mesh format -->
  <xacro:property name="mesh_ext" value="stl"/>
  <xacro:if value="$(arg use_collada)">
    <xacro:property name="mesh_ext" value="dae"/>
  </xacro:if>

  <material name="dji_dark_grey">
    <color rgba="0.18 0.19 0.20 1.0"/>
  </material>
  <material name="dji_silver">
    <color rgba="0.75 0.75 0.76 1.0"/>
  </material>

  <!-- Optional World Link to fix the gimbal in space -->
  <xacro:if value="$(arg fix_base)">
    <link name="world"/>
    <joint name="world_to_base" type="fixed">
      <parent link="world"/>
      <child link="base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <!-- ======================== BASE LINK ======================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.0138 0.0004 0.0617" rpy="0 0 0"/>
      <mass value="0.180"/>
      <inertia ixx="1.939541e-04" ixy="0" ixz="0"
               iyy="2.201141e-04" iyz="0"
               izz="6.312664e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dji_osmo_mobile_6/meshes/${mesh_ext}/base_link.${mesh_ext}"/>
      </geometry>
      <material name="dji_dark_grey"/>
    </visual>
    <collision>
      <origin xyz="-0.0138 0.0004 0.0617" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0273" length="0.1082"/>
      </geometry>
    </collision>
  </link>

  <!-- ======================== YAW (PAN) JOINT & LINK ======================== -->
  <joint name="yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="yaw_link"/>
    <origin xyz="0.0000 0.0000 0.1070" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.80" upper="2.80" effort="1.2" velocity="6.28"/>
    <dynamics damping="0.01" friction="0.005"/>
  </joint>

  <link name="yaw_link">
    <inertial>
      <origin xyz="0.0025 -0.0163 0.0150" rpy="0 0 0"/>
      <mass value="0.055"/>
      <inertia ixx="2.014623e-05" ixy="0" ixz="0"
               iyy="9.048004e-06" iyz="0"
               izz="1.957288e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dji_osmo_mobile_6/meshes/${mesh_ext}/yaw_link.${mesh_ext}"/>
      </geometry>
      <material name="dji_dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0.0025 -0.0163 0.0150" rpy="0 0 0"/>
      <geometry>
        <box size="0.0304 0.0578 0.0324"/>
      </geometry>
    </collision>
  </link>

  <!-- ======================== ROLL JOINT & LINK ======================== -->
  <joint name="roll_joint" type="revolute">
    <parent link="yaw_link"/>
    <child link="roll_link"/>
    <origin xyz="0.0072 -0.0357 0.0277" rpy="0 0 0"/>
    <axis xyz="0.9205 0.3908 0"/>
    <limit lower="-1.60" upper="1.60" effort="1.2" velocity="6.28"/>
    <dynamics damping="0.01" friction="0.005"/>
  </joint>

  <link name="roll_link">
    <inertial>
      <origin xyz="0.0130 0.0030 0.0407" rpy="0 0 0"/>
      <mass value="0.065"/>
      <inertia ixx="8.008248e-05" ixy="0" ixz="0"
               iyy="4.648445e-05" iyz="0"
               izz="4.917453e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dji_osmo_mobile_6/meshes/${mesh_ext}/roll_link.${mesh_ext}"/>
      </geometry>
      <material name="dji_dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0.0130 0.0030 0.0407" rpy="0 0 0"/>
      <geometry>
        <box size="0.0379 0.0874 0.0845"/>
      </geometry>
    </collision>
  </link>

  <!-- ======================== PITCH (TILT) JOINT & LINK ======================== -->
  <joint name="pitch_joint" type="revolute">
    <parent link="roll_link"/>
    <child link="pitch_link"/>
    <origin xyz="0.0017 0.0543 0.0591" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.80" upper="1.80" effort="1.2" velocity="6.28"/>
    <dynamics damping="0.01" friction="0.005"/>
  </joint>

  <link name="pitch_link">
    <inertial>
      <origin xyz="-0.0090 -0.0063 0.0105" rpy="0 0 0"/>
      <mass value="${0.040 + $(arg phone_mass)}"/>
      <inertia ixx="7.438187e-05" ixy="0" ixz="0"
               iyy="5.099382e-05" iyz="0"
               izz="8.860921e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://dji_osmo_mobile_6/meshes/${mesh_ext}/pitch_link.${mesh_ext}"/>
      </geometry>
      <material name="dji_silver"/>
    </visual>
    <collision>
      <origin xyz="-0.0090 -0.0063 0.0105" rpy="0 0 0"/>
      <geometry>
        <box size="0.0422 0.0553 0.0317"/>
      </geometry>
    </collision>
  </link>

  <!-- ======================== IMU SENSOR FRAME ======================== -->
  <joint name="imu_joint" type="fixed">
    <parent link="pitch_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.0090 -0.0063 0.0105" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <!-- ======================== GAZEBO CONFIGURATION ======================== -->
  <gazebo reference="imu_link">
    <sensor name="gimbal_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200.0</update_rate>
      <visualize>true</visualize>
      <topic>/gimbal/imu/data</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0015</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0015</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0015</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/gimbal</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="base_link"><material>Gazebo/DarkGrey</material><mu1>0.8</mu1><mu2>0.8</mu2></gazebo>
  <gazebo reference="yaw_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="roll_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="pitch_link"><material>Gazebo/Grey</material></gazebo>

</robot>
